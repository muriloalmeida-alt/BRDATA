  "long": {
    "_doc": "Timeout por classe (critério objetivo: duração MÁXIMA medida >= 60s em alguma das 5 execuções de 25/10/2026 — baseline A/B/C na concorrência 6, e concorrências 8 e 10). Na concorrência 8, test_play_by_play_v2.js estourou o limite global de 90s; com o arquivo de dados acumulado, test_training_evolution.js também. O limite destes é timeoutMs; os demais seguem o --timeout (padrão 90s; o maior deles mediu 47.7s).",
    "timeoutMs": 180000,
    "tests": [
      "test_play_by_play_v2.js",
      "test_events.js",
      "test_tickets.js",
      "test_save.js",
      "test_training_evolution.js",
      "test_tickets_form.js",
      "test_loan_advanced.js",
      "test_noticias_fullscreen_fluxo.js",
      "test_patrocinio.js"
    ]
  },
  "exclusive": {
    "_doc": "Testes que precisam rodar SOZINHOS, depois dos demais (estado compartilhado que não dá pra isolar). Vazio desde a Fase B: test_save_limit_001_careerstore.js, que lia/gravava o server/data/careers.json do repositório enquanto o servidor o regravava, passou a usar uma cópia do careerStore num diretório temporário próprio.",
    "tests": []
  },
  "serverProfiles": {
    "_doc": "Testes que precisam de um servidor configurado de outro jeito. Com --isolated-server, cada perfil sobe um servidor isolado PRÓPRIO (dados vazios), depois de todos os outros testes, aplicando env (variáveis do servidor), preBoot (script rodado ANTES do boot com SERVER_DIR apontando pra cópia isolada) e testEnv (variáveis passadas ao teste). {email} vira um e-mail único por servidor. Sem --isolated-server esses testes rodam contra o servidor que estiver de pé, como antes (e falham se ele não estiver configurado assim). Antes da Fase B nenhum runner fazia isso e os 2 testes falhavam em toda execução.",
    "frozen": {
      "_doc": "Catálogo real congelado (server/frozen-catalog) em vez do Modo Exemplo.",
      "env": {
        "DATA_PROVIDER": "frozen"
      },
      "tests": [
        "test_frozen_provider.js"
      ]
    },
    "loja-creditos": {
      "_doc": "Conta com Créditos BR concedidos via addCredits (mesma função do webhook do Mercado Pago) antes do servidor subir — ver _grant_test_credits.js.",
      "preBoot": {
        "script": "_grant_test_credits.js",
        "args": [
          "{email}",
          "senha123",
          "5000"
        ]
      },
      "testEnv": {
        "LOJA_TEST_EMAIL": "{email}",
        "LOJA_TEST_CREDITS": "5000"
      },
      "tests": [
        "test_loja_pagamento_real.js"
      ]
    }
  },
